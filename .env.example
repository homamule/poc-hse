# Identifiants OAuth2 générés sur le portail PISTE (https://piste.gouv.fr)
# Ne jamais committer le fichier .env contenant les vraies valeurs.
# Requis pour : npm run collect et npm run collect:batch
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=

# Environnement PISTE : sandbox | production
PISTE_ENV=sandbox

# Identifiant d'article Légifrance (LEGIARTI…), pour npm run collect uniquement.
# Non requis pour npm run collect:batch (les IDs viennent du fichier --input).
# Voir le README pour la méthode de récupération. Ne pas inventer d'identifiant.
LEGIFRANCE_ARTICLE_ID=

# Délai maximal des requêtes HTTP en millisecondes (optionnel, défaut : 30000)
REQUEST_TIMEOUT_MS=30000

# Neo4j — uniquement pour npm run graph:import -- --apply
# Ne jamais committer de vrais mots de passe. Non lus en mode aperçu (sans --apply).
HSE_NEO4J_URI=
HSE_NEO4J_USER=
HSE_NEO4J_PASSWORD=
HSE_NEO4J_DATABASE=neo4j
