# Identifiants OAuth2 générés sur le portail PISTE (https://piste.gouv.fr)
# Ne jamais committer le fichier .env contenant les vraies valeurs.
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=

# Environnement PISTE : sandbox | production
PISTE_ENV=sandbox

# Identifiant d'article Légifrance (LEGIARTI…), obtenu sur le site officiel.
# Voir le README pour la méthode de récupération. Ne pas inventer d'identifiant.
#article L4121-1 du Code du travail
LEGIFRANCE_ARTICLE_ID=LEGIARTI000035640828

# Délai maximal des requêtes HTTP en millisecondes (optionnel, défaut : 30000)
REQUEST_TIMEOUT_MS=30000
